{
  "capabilities": [
    "browser_navigate", "browser_navigate_back", "browser_snapshot", "browser_click",
    "browser_type", "browser_fill_form", "browser_press_key", "browser_select_option",
    "browser_hover", "browser_evaluate", "browser_file_upload", "browser_handle_dialog",
    "browser_wait_for", "browser_console_messages", "browser_network_requests", "browser_network_request",
    "browser_resize", "browser_take_screenshot", "browser_tabs", "browser_close"
  ],
  "harnesses": {
    "claude": {
      "toolPrefix": "mcp__plugin_playwright_playwright__",
      "serverKey": "playwright",
      "grantStyle": "list",
      "modelField": "sonnet",
      "tierDefault": "Sonnet",
      "tierHeavy": "Opus",
      "dispatch": "via the Agent/Task tool, `subagent_type: qa-e2e-pilot`",
      "globalRolesDir": "~/.claude/qa-e2e-pilot/roles",
      "engineSkillsDir": "${CLAUDE_PLUGIN_ROOT:-$HOME/.claude}/skills",
      "commandAgentLine": "",
      "agentCmd": "claude -p \"/qa-run \\\"$QA_TARGET\\\" $QA_CHECKLIST\"",
      "vision": {"capable": true, "read": "Read"}
    },
    "codex": {
      "toolPrefix": "playwright-qa__",
      "serverKey": "playwright-qa",
      "grantStyle": "scope",
      "modelField": "",
      "tierDefault": "the default",
      "tierHeavy": "the most-capable",
      "dispatch": "as the qa-e2e-pilot agent profile (.codex/agents/qa-e2e-pilot.toml) — you are that persona when this prompt runs; proceed directly",
      "globalRolesDir": "~/.codex/qa-e2e-pilot/roles",
      "engineSkillsDir": ".agents/skills",
      "commandAgentLine": "",
      "agentCmd": "codex exec \"/qa-run $QA_TARGET $QA_CHECKLIST\"",
      "vision": {"capable": true, "read": "localImage"}
    },
    "pi": {
      "toolPrefix": "mcp:playwright-qa/",
      "serverKey": "playwright-qa",
      "grantStyle": "proxy",
      "modelField": "",
      "tierDefault": "the default",
      "tierHeavy": "the most-capable",
      "dispatch": "as the qa-e2e-pilot persona (.pi/agents/) — you are that persona when this prompt-template runs; proceed directly",
      "globalRolesDir": "~/.pi/qa-e2e-pilot/roles",
      "engineSkillsDir": ".pi/agents/skills",
      "commandAgentLine": "",
      "agentCmd": "pi -p \"/qa-run $QA_TARGET $QA_CHECKLIST\"",
      "vision": {"capable": true, "read": "adapter"}
    },
    "opencode": {
      "toolPrefix": "playwright-qa_",
      "serverKey": "playwright-qa",
      "grantStyle": "glob",
      "modelField": "",
      "tierDefault": "the default",
      "tierHeavy": "the most-capable",
      "dispatch": "under the `qa-e2e-pilot` agent (bound by this command's `agent:` frontmatter)",
      "globalRolesDir": "~/.config/opencode/qa-e2e-pilot/roles",
      "engineSkillsDir": ".opencode/skills",
      "commandAgentLine": "agent: qa-e2e-pilot\n",
      "agentCmd": "opencode run \"/qa-run $QA_TARGET $QA_CHECKLIST\"",
      "vision": {"capable": true, "read": "Read"}
    }
  }
}
