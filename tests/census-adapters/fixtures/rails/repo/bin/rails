#!/usr/bin/env bash
# Fake bin/rails: `routes` prints the fixture; FAKE_RAILS_FAIL=1 fails like a missing database.
[ -n "${FAKE_RAILS_LOG:-}" ] && printf '%s|%s\n' "$(pwd)" "$*" >> "$FAKE_RAILS_LOG"
[ "${FAKE_RAILS_FAIL:-}" = "1" ] && { echo "PG::ConnectionBad: could not connect to server" >&2; exit 1; }
[ "$*" = "routes" ] || { echo "fake rails: unexpected argv: $*" >&2; exit 64; }
cat "$(dirname "$0")/../routes.txt"
