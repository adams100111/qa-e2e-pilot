{
  "_doc": "Copy to .qa/config.json and edit. Driver presets resolve the browser endpoint: managed (zero-config built-in Playwright, any OS), windows+wsl (attach to Windows Chrome from WSL), windows, wsl, linux, mac. The managed driver is the default; attended CDP is opt-in. apiOrigin is optional — set it only when the backend API is served from a different origin than baseUrl (enables cross-origin probing; leave \"\" for same-origin). repos are all optional (single-repo works); skills read them by role. allowApiWrites is OFF by default — direct API writes/seeding are gated behind it AND a disposable-env marker.",
  "baseUrl": "http://localhost:3000",
  "apiOrigin": "",
  "auth": {
    "storageState": ".qa/auth/storageState.json"
  },
  "drivers": [
    {
      "id": "managed",
      "server": "playwright",
      "preset": "managed"
    },
    {
      "id": "mine",
      "server": "playwright-cdp",
      "preset": "windows+wsl",
      "cdpEndpoint": "http://localhost:9222"
    }
  ],
  "maxParallel": 3,
  "repos": [
    { "role": "frontend", "path": "/home/dev/projects/elevator/pioneer-dashboard" },
    { "role": "backend", "path": "/home/dev/projects/elevator/backend" },
    { "role": "reference", "path": "/home/dev/projects/elevator/governance" }
  ],
  "allowApiWrites": false,
  "seedableEnvMarker": "QA_DISPOSABLE_ENV",
  "_stackDoc": "Stack detection + production safety. environment: 'auto' infers production from a non-localhost baseUrl with no seedableEnvMarker (forces writes off, conservative fingerprint, crawl off); set 'disposable' or 'production' to override. allowBlackboxCrawl: only true lets the agent live-crawl a non-disposable target (else it verifies only checklist-named surfaces). fingerprintPaths: <=4 well-known doc paths probed read-only during detection. noProbePaths: paths never to fetch. crawlDenyPatterns: extra link patterns to skip on a black-box crawl (logout/delete/etc. are always skipped). maxRequestsPerSecond: throttle for fingerprint/crawl GETs.",
  "environment": "auto",
  "allowBlackboxCrawl": false,
  "fingerprintPaths": ["/openapi.json", "/swagger/v1/swagger.json"],
  "noProbePaths": [],
  "crawlDenyPatterns": [],
  "maxRequestsPerSecond": 2,
  "memory": {
    "backend": "file",
    "mem0": {
      "endpoint": "",
      "apiKeyEnv": "MEM0_API_KEY",
      "userId": "qa-e2e-pilot"
    }
  }
}
