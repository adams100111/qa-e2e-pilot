{
  "_doc": "Copy to .qa/config.json and edit. Driver presets resolve the browser endpoint: managed (zero-config built-in Playwright, any OS), windows+wsl (attach to Windows Chrome from WSL), windows, wsl, linux, mac. The managed driver is the default; attended CDP is opt-in. apiOrigin is optional — set it only when the backend API is served from a different origin than baseUrl (enables cross-origin probing; leave \"\" for same-origin). repos are all optional (single-repo works); skills read them by role. allowApiWrites is OFF by default — direct API writes/seeding are gated behind it AND a disposable-env marker.",
  "baseUrl": "http://localhost:3000",
  "apiOrigin": "",
  "auth": {
    "storageState": ".qa/auth/storageState.json"
  },
  "drivers": [
    {
      "id": "managed",
      "server": "playwright",
      "preset": "managed"
    },
    {
      "id": "mine",
      "server": "playwright-cdp",
      "preset": "windows+wsl",
      "cdpEndpoint": "http://localhost:9222"
    }
  ],
  "maxParallel": 3,
  "repos": [
    { "role": "frontend", "path": "/home/dev/projects/elevator/pioneer-dashboard" },
    { "role": "backend", "path": "/home/dev/projects/elevator/backend" },
    { "role": "reference", "path": "/home/dev/projects/elevator/governance" }
  ],
  "allowApiWrites": false,
  "seedableEnvMarker": "QA_DISPOSABLE_ENV",
  "_stackDoc": "Stack detection + production safety. environment: 'auto' infers production from a non-localhost baseUrl with no seedableEnvMarker (forces writes off, conservative fingerprint, crawl off); set 'disposable' or 'production' to override. allowBlackboxCrawl: only true lets the agent live-crawl a non-disposable target (else it verifies only checklist-named surfaces). fingerprintPaths: <=4 well-known doc paths probed read-only during detection. noProbePaths: paths never to fetch. crawlDenyPatterns: extra link patterns to skip on a black-box crawl (logout/delete/etc. are always skipped). maxRequestsPerSecond: throttle for fingerprint/crawl GETs.",
  "environment": "auto",
  "allowBlackboxCrawl": false,
  "fingerprintPaths": ["/openapi.json", "/swagger/v1/swagger.json"],
  "noProbePaths": [],
  "crawlDenyPatterns": [],
  "maxRequestsPerSecond": 2,
  "memory": {
    "backend": "file",
    "mem0": {
      "endpoint": "",
      "apiKeyEnv": "MEM0_API_KEY",
      "userId": "qa-e2e-pilot"
    }
  },
  "_viewportDoc": "Viewport, responsive matrix, persona lens, detection, gate knobs, interaction discipline, and isolation (ADR-0008/ADR-0015/ADR-0003). viewport: the desktop size Pre-flight applies via browser_resize before any criterion runs. responsiveMatrix: opt-in extra viewports (e.g. mobile); empty = off (default) — when set, ONLY viewport-sensitive UX criteria (overflow/target-size) re-run per listed viewport, functional criteria are never multiplied. persona.lens: the default review lens (skeptical-auditor | first-time-user | a11y-user) applied on top of the role axis already confirmed in personas[]/authz-matrix.json (role x lens — this key only sets the lens; it never regenerates roles). detection.ux: which UX detector streams run (objective = real fail@FE verdicts; advisoryAesthetics = subjective, reported, never gated). passGate.enforce: whether checkpoint.sh's evidence gate (ADR-0010) rejects an unevidenced pass — leave true; disable only for a temporary, deliberate escape hatch. humanInteraction.enforce: gate human interaction via ADR-0015; audit-only fallback, never silently off. saveSession: OPT-IN (default false). true only when the Playwright MCP is actually run with --save-session (the default managed instance is not) — enables Check 0 (independent session.md reconciliation). false → the gate runs the act-lint + fingerprint checks and flags that independent-log verification was unavailable. maxOptOutRate: flag a run whose nonUiActionReason rate exceeds it — opt-out-abuse guard. isolation.maxOpenContexts: cap concurrent browser contexts; default = effective concurrency, ~1 under ADR-0003. mechanism: isolated in-memory profile vs user-data-dir; never shared-browser-context for fan-out. Note: allowApiWrites+disposable-marker remain the ONLY write gate — origin lists are not a write boundary. criteriaBudget: soft cap on criteria generated/run in one pass, a cost lever, not a coverage cut.",
  "viewport": { "width": 1440, "height": 900 },
  "responsiveMatrix": [],
  "persona": { "lens": "skeptical-auditor" },
  "detection": {
    "ux": { "objective": true, "advisoryAesthetics": true }
  },
  "passGate": { "enforce": true },
  "humanInteraction": { "enforce": true, "saveSession": false, "maxOptOutRate": 0.2, "sessionLogDir": ".playwright-mcp" },
  "isolation": { "maxOpenContexts": 1, "mechanism": "isolated" },
  "criteriaBudget": 60
}
